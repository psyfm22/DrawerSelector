<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/passwordAlertCL"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/passwordAlertDialogueCL"
        android:layout_width="423dp"
        android:layout_height="320dp"
        android:background="@drawable/alert_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.493">

        <TextView
            android:id="@+id/passwordAlertTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingTop="0dp"
            android:text="Enter Password: "
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/passwordAlertDialogueCL" />

        <EditText
            android:id="@+id/passwordAlertET"
            android:layout_width="245dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_background"
            android:ems="10"
            android:enabled="false"
            android:gravity="center"
            android:hint="Password..."
            android:inputType="numberPassword"
            android:maxLength="4"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/passwordAlertTitleTV" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginBottom="8dp"
            app:columnCount="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:orientation="horizontal"
            app:rowCount="4">

            <Button
                android:id="@+id/passwordAlertOneB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme"
                app:layout_column="0"
                app:layout_row="0" />

            <Button
                android:id="@+id/passwordAlertTwoB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="2"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertThreeB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="3"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertFourB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="4"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertFiveB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="5"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertSixB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="6"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertSevenB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="7"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertEightB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="8"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertNineB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="9"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertDeleteB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="X"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertZeroB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:theme="@style/AppButtonTheme" />

            <Button
                android:id="@+id/passwordAlertEnterB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text=">"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:theme="@style/AppButtonTheme" />

        </androidx.gridlayout.widget.GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>